# profiles/Brewfile.default - Default profile additions
# Layered on top of the base Brewfile.
#
# Contains all profile-specific packages collapsed into one file.
# To customise, copy this file and pass MACHINE_PROFILE=<name> at runtime.

# ============================================
# Additional taps
# ============================================
tap "fluxcd/tap"
tap "go-task/tap"

# ============================================
# Communication (work)
# ============================================
cask "microsoft-teams"        # Microsoft Teams

# ============================================
# Development / cloud (work)
# ============================================
brew "azure-cli"              # Azure CLI

# ============================================
# GitOps (homelab)
# ============================================
brew "fluxcd/tap/flux"        # Flux CD — GitOps continuous delivery operator

# ============================================
# Infrastructure / automation (homelab)
# ============================================
brew "direnv"                 # Per-directory environment variables
brew "go-task/tap/go-task"    # Taskfile runner (modern make alternative)
brew "ipcalc"                 # IP address / subnet calculator
brew "jq"                     # JSON processor
brew "kustomize"              # Kubernetes configuration customization
brew "pre-commit"             # Git hook framework
brew "sops"                   # Secrets OPerationS (encryption for config files)
brew "yamllint"               # YAML linter

# ============================================
# MAS — Work SSO
# ============================================
mas "Okta Verify",            id: 490179405   # Work SSO authenticator
